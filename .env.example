# Circle developer-controlled wallets — see console.circle.com
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# Escrow wallet (Circle-managed) — holds funds, pays refunds
ESCROW_WALLET_ADDRESS=

# Client wallet — stand-in for a test visitor/payer
CLIENT_WALLET_ADDRESS=

# Seller wallet (self-custodied, viem-generated) — receives the $0.01 payment
X402_SELLER_ADDRESS=
X402_SELLER_PRIVATE_KEY=

# Validator wallet (Circle-managed SCA) — holds the ERC-8004 on-chain identity
VALIDATOR_WALLET_ID=
VALIDATOR_WALLET_ADDRESS=
VALIDATOR_AGENT_ID=

# Reporter wallet (Circle-managed SCA) — submits feedback to ReputationRegistry
REPORTER_WALLET_ID=
REPORTER_WALLET_ADDRESS=

# OpenAI — generates the plain-language prediction rationale
OPENAI_API_KEY=
